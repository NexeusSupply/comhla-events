# Login: put the app behind Cloudflare Access, then set both of these (same as SEO Desk).
# Team domain looks like comhla.cloudflareaccess.com. The AUD tag is on the Access application's Overview tab.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Stopgap before Access is ready: a password prompt on the whole site. Ignored once Access is set.
PREVIEW_PASSWORD=

# Local development only. On Railway leave these out: Railway sets PORT and the image sets DB_PATH.
# PORT=3050
# DB_PATH=./data/comhla-events.sqlite
